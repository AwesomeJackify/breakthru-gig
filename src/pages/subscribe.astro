---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { Icon } from "astro-icon/components";
import config from "../../breakthru.config.json";

const user = Astro.locals.user;
const focusProduct = Astro.url.searchParams.get("product");
const tiers = focusProduct
  ? config.services.tiers.filter((t: { product?: string }) => t.product === focusProduct)
  : config.services.tiers;
---

<Layout title="Plans — Breakthru" description="Choose a Breakthru plan and start your transformation.">
  <Nav />
  <main class="min-h-screen px-4 py-24">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-12">
        {focusProduct ? (
          <>
            <h1 class="text-4xl font-bold mb-3">{tiers[0]?.title ?? config.services.headline}</h1>
            <p class="text-base-content/60 text-lg">{tiers[0]?.description ?? config.services.body}</p>
            <a href="/subscribe" class="inline-block mt-4 text-sm text-base-content/50 hover:text-base-content underline underline-offset-2">View all plans</a>
          </>
        ) : (
          <>
            <h1 class="text-4xl font-bold mb-3">{config.services.headline}</h1>
            <p class="text-base-content/60 text-lg">{config.services.body}</p>
          </>
        )}
      </div>

      <div class:list={["grid gap-6", focusProduct ? "grid-cols-1 max-w-lg mx-auto" : "grid-cols-1 md:grid-cols-3"]}>
        {tiers.map((tier: { tier: string; title: string; description: string; features: string[]; popular: boolean; price: string; billing: string; product: string }) => (
          <div class:list={["card border", tier.popular ? "border-primary shadow-xl bg-base-200 scale-[1.03]" : "border-base-300 bg-base-200/60"]}>
            {tier.popular && (
              <div class="bg-primary text-primary-content text-center text-xs font-bold py-2 px-4 rounded-t-2xl tracking-widest uppercase">
                {tier.tier}
              </div>
            )}
            <div class="card-body gap-5 p-8">
              <div>
                {!tier.popular && (
                  <p class="text-xs text-base-content/40 uppercase tracking-widest mb-1">{tier.tier}</p>
                )}
                <h2 class="card-title text-2xl font-bold">{tier.title}</h2>
                <p class="text-sm text-base-content/60 mt-2 leading-relaxed">{tier.description}</p>
              </div>

              <div class="py-2 border-y border-base-300">
                <span class="text-4xl font-black">{tier.price}</span>
                <span class="text-sm text-base-content/40 ml-1">{tier.billing}</span>
              </div>

              <ul class="flex flex-col gap-3">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-3 text-sm">
                    <Icon name="lucide:check" class="w-4 h-4 text-success mt-0.5 shrink-0" />
                    {f}
                  </li>
                ))}
              </ul>

              <div class="card-actions mt-2">
                {tier.product === "12week_programme" || tier.product === "meal_plan_pdf" ? (
                  <a href={tier.product === "12week_programme" ? "/programmes/12-week" : "/programmes/eat-like-me"} class="btn btn-warning w-full text-warning-content font-bold text-base">
                    Buy now
                  </a>
                ) : user ? (
                  <form method="POST" action={tier.product === "subscription" ? "/api/checkout/subscription" : "/api/checkout/one-time"} class="w-full">
                    <input type="hidden" name="product" value={tier.product} />
                    <button type="submit" class="btn btn-warning w-full text-warning-content font-bold text-base">
                      Buy now
                    </button>
                  </form>
                ) : (
                  <a href="/login" class="btn btn-warning w-full text-warning-content font-bold text-base">
                    Buy now
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
