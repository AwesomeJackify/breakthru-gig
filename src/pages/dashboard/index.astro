---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Icon } from "astro-icon/components";
import { getUserEntitlements } from "../../lib/access";
import config from "../../../breakthru.config.json";

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase;

const [entitlements, subResult, profileResult, onboardingResult] = await Promise.all([
  getUserEntitlements(user.id, supabase),
  supabase
    .from("subscriptions")
    .select("status, current_period_end")
    .eq("user_id", user.id)
    .order("current_period_end", { ascending: false })
    .limit(1)
    .maybeSingle(),
  supabase
    .from("profiles")
    .select("stripe_customer_id")
    .eq("id", user.id)
    .single(),
  supabase
    .from("programme_onboarding")
    .select("status, submitted_at")
    .eq("user_id", user.id)
    .maybeSingle(),
]);

const subscription = subResult.data;
const hasStripeCustomer = !!profileResult.data?.stripe_customer_id;
const programmeForm = onboardingResult.data;
const hasCompletedProgrammeForm = programmeForm?.status === "submitted" || programmeForm?.status === "in_progress" || programmeForm?.status === "delivered";
const { programmeCheckout, mealPlanCheckout } = config;
const hasAnything =
  entitlements.hasSubscription ||
  entitlements.hasProgramme ||
  entitlements.hasMealPlan ||
  subscription?.status === "canceled";

const renewsAt = subscription?.current_period_end
  ? new Date(subscription.current_period_end).toLocaleDateString("en-NZ", {
      day: "numeric",
      month: "long",
      year: "numeric",
    })
  : null;

const firstName = user.email.split("@")[0];
const checkoutNotice = Astro.url.searchParams.get("notice");

const cards = [
  {
    label: "Video library",
    description:
      "Access your full workout, nutrition, and mindset video library.",
    href: "/videos",
    unlockHref: "/subscribe?product=subscription",
    available: entitlements.hasSubscription || entitlements.hasProgramme,
    icon: "lucide:video",
  },
  {
    label: "Downloads",
    description: "Meal plans, programme PDFs, and resources.",
    href: "/downloads",
    unlockHref: "/subscribe",
    available: entitlements.hasMealPlan || entitlements.hasProgramme,
    icon: "lucide:download",
  },
];
---

<DashboardLayout title="Dashboard — Breakthru">
  <div class="px-6 py-10 max-w-4xl mx-auto space-y-10">
    {/* Welcome row */}
    <div class="flex items-start justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-2xl font-bold tracking-tight">
          Welcome back, {firstName}.
        </h1>
        <p class="text-base-content/40 mt-1 text-xs font-mono">{user.email}</p>
      </div>
      <div class="flex items-center gap-2 shrink-0 mt-1">
        {
          entitlements.hasSubscription ? (
            <div class="flex items-center gap-2">
              <span class="status status-success" />
              <span class="text-sm text-base-content/60">Active member</span>
            </div>
          ) : entitlements.hasProgramme || entitlements.hasMealPlan ? (
            <div class="flex items-center gap-2">
              <span class="status status-success" />
              <span class="text-sm text-base-content/60">Active plan</span>
            </div>
          ) : (
            <div class="flex items-center gap-2">
              <span class="status status-neutral" />
              <span class="text-sm text-base-content/40">No active plan</span>
            </div>
          )
        }
      </div>
    </div>

    {checkoutNotice === "programme-included" && (
      <div class="alert alert-info">
        <div>
          <h2 class="font-semibold">{programmeCheckout.memberHeadline}</h2>
          <p class="text-sm">{programmeCheckout.memberBody}</p>
        </div>
      </div>
    )}

    {checkoutNotice === "programme-owned" && (
      <div class="alert alert-info"><div><h2 class="font-semibold">{programmeCheckout.alreadyOwnedHeadline}</h2><p class="text-sm">{programmeCheckout.alreadyOwnedBody}</p></div></div>
    )}

    {checkoutNotice === "meal-plan-owned" && (
      <div class="alert alert-info"><div><h2 class="font-semibold">{mealPlanCheckout.alreadyOwnedHeadline}</h2><p class="text-sm">{mealPlanCheckout.alreadyOwnedBody}</p></div></div>
    )}

    {checkoutNotice === "onboarding-submitted" && (
      <div class="alert alert-success">
        <div>
          <h2 class="font-semibold">{programmeCheckout.formSubmittedHeadline}</h2>
          <p class="text-sm">{programmeCheckout.formCompletedNote}</p>
        </div>
      </div>
    )}

    {/* Quick access cards (asymmetric bento) */}
    <div class="grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-4">
      {
        cards.map((card) => (
          <div class="card border bg-base-200 border-base-300 relative overflow-hidden card-lift">
            {!card.available && (
              <div class="absolute inset-0 bg-base-200/90 backdrop-blur-[1px] flex flex-col items-center justify-center gap-3 z-10">
                <Icon name="lucide:lock" class="w-5 h-5 text-base-content/30" />
                <a href={card.unlockHref} class="btn btn-primary btn-xs">
                  Unlock
                </a>
              </div>
            )}
            <div
              class:list={["card-body p-6", !card.available && "opacity-30"]}
            >
              <div class="text-primary mb-3">
                <Icon name={card.icon} class="w-6 h-6" />
              </div>
              <h2 class="font-semibold text-base">{card.label}</h2>
              <p class="text-sm text-base-content/50 mt-1">
                {card.description}
              </p>
              <div class="card-actions mt-4">
                <a href={card.href} class="btn btn-primary btn-sm">
                  Open
                </a>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    {/* Billing */}
    <div>
      <div
        class="flex items-center justify-between pb-4 border-b border-base-300"
      >
        <h2
          class="text-xs font-semibold text-base-content/40 uppercase tracking-wider"
        >
          Billing
        </h2>
        {
          hasStripeCustomer && (
            <form action="/api/stripe/portal" method="POST">
              <button type="submit" class="btn btn-ghost btn-xs">
                Manage billing
              </button>
            </form>
          )
        }
      </div>

      <div class="divide-y divide-base-300/60">
        {/* Monthly membership — highlighted row */}
        <div class="flex items-center gap-3 py-4 px-4 -mx-4 rounded-xl bg-primary/5 border border-primary/20">
          {
            entitlements.hasProgramme ? (
              <span class="badge badge-success badge-sm shrink-0">Active</span>
            ) : subscription?.status === "canceled" ? (
              <span class="badge badge-ghost badge-sm shrink-0">Cancelled</span>
            ) : (
              <span class="badge badge-ghost badge-sm shrink-0">Inactive</span>
            )
          }
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-x-2 gap-y-1 min-w-0">
              <p class="text-sm font-semibold">Monthly membership</p>
              {!entitlements.hasSubscription && (
                <span class="badge badge-primary badge-xs rounded-full shrink-0 whitespace-nowrap">
                  Most popular
                </span>
              )}
            </div>
            {
              entitlements.hasSubscription && renewsAt && (
                <p class="text-xs text-base-content/40 font-mono">
                  Renews {renewsAt}
                </p>
              )
            }
            {
              subscription?.status === "canceled" && (
                <p class="text-xs text-base-content/40">Access ended</p>
              )
            }
          </div>
          {
            !entitlements.hasSubscription && (
              <a
                href="/subscribe?product=subscription"
                class="btn btn-warning btn-xs shrink-0 font-bold"
              >
                {subscription?.status === "canceled"
                  ? "Resubscribe"
                  : "Subscribe"}
              </a>
            )
          }
        </div>

        {/* 12-week programme */}
        <div class="flex items-center gap-3 py-4">
          {
            entitlements.hasSubscription ? (
              <div
                class="tooltip tooltip-right shrink-0"
                data-tip="Included with your monthly membership"
              >
                <span class="badge badge-success badge-sm cursor-help">
                  Included
                </span>
              </div>
            ) : (
              <span
                class:list={[
                  "badge badge-sm shrink-0",
                  entitlements.hasProgramme ? "badge-success" : "badge-ghost",
                ]}
              >
                {entitlements.hasProgramme ? "Purchased" : "Not purchased"}
              </span>
            )
          }
          <div class="flex-1">
            <p class="text-sm font-medium">12-week programme</p>
            {
              entitlements.hasSubscription && (
                <p class="text-xs text-base-content/40">
                  Included with monthly membership
                </p>
              )
            }
            {
              !entitlements.hasSubscription && entitlements.hasProgramme && (
                <p class="text-xs text-base-content/40">One-time purchase</p>
              )
            }
          </div>
          {
            entitlements.hasSubscription ? (
              hasCompletedProgrammeForm ? (
                <div class="tooltip tooltip-left" data-tip={programmeCheckout.formCompletedNote}>
                  <span class="badge badge-success badge-sm cursor-help">Form completed</span>
                </div>
              ) : (
                <a
                  href="/programmes/12-week/onboarding"
                  class="btn btn-primary btn-xs shrink-0"
                >
                  Complete form
                </a>
              )
            ) : !entitlements.hasProgramme && (
              <a
                href="/subscribe?product=12week_programme"
                class="btn btn-outline btn-xs shrink-0"
              >
                Add
              </a>
            )
          }
        </div>

        {/* Meal plan */}
        <div class="flex items-center gap-3 py-4">
          {
            entitlements.hasSubscription ? (
              <div
                class="tooltip tooltip-right shrink-0"
                data-tip="Included with your monthly membership"
              >
                <span class="badge badge-success badge-sm cursor-help">
                  Included
                </span>
              </div>
            ) : (
              <span
                class:list={[
                  "badge badge-sm shrink-0",
                  entitlements.hasMealPlan ? "badge-success" : "badge-ghost",
                ]}
              >
                {entitlements.hasMealPlan ? "Purchased" : "Not purchased"}
              </span>
            )
          }
          <div class="flex-1">
            <p class="text-sm font-medium">30 Day Eat Like Me</p>
            {
              entitlements.hasSubscription && (
                <p class="text-xs text-base-content/40">
                  Included with monthly membership
                </p>
              )
            }
            {
              !entitlements.hasSubscription && entitlements.hasMealPlan && (
                <p class="text-xs text-base-content/40">One-time purchase</p>
              )
            }
          </div>
          {
            !entitlements.hasMealPlan && (
              <a
                href="/subscribe?product=meal_plan_pdf"
                class="btn btn-outline btn-xs shrink-0"
              >
                Add
              </a>
            )
          }
        </div>
      </div>

      {
        !hasAnything && (
          <div class="pt-6">
            <p class="text-sm text-base-content/40 mb-3">
              No purchases yet. Get started with a membership or programme.
            </p>
            <a href="/subscribe" class="btn btn-primary btn-sm">
              View plans
            </a>
          </div>
        )
      }
    </div>

    {/* 12-week programme notification (shown for subscribers, dismissible) */}
    {
      entitlements.hasSubscription && (
        <div
          id="programme-toast"
          class="fixed bottom-6 right-6 z-50 max-w-sm w-full"
        >
          <div class="relative alert bg-base-200 border border-primary/40 shadow-2xl flex-col items-start gap-3 p-5 pt-7 rounded-2xl">
            <button
              id="dismiss-toast"
              class="absolute top-1.5 right-1.5 btn btn-ghost btn-xs btn-circle"
              aria-label="Dismiss"
            >
              <Icon name="lucide:x" class="w-3.5 h-3.5" />
            </button>
            <div class="flex items-center gap-3">
              <div class="indicator shrink-0">
                <span class="indicator-item badge badge-primary badge-xs animate-pulse rounded-full" />
                <div class="w-10 h-10 rounded-full flex items-center justify-center">
                  <Icon
                    name="lucide:clipboard-list"
                    class="w-10 h-10 text-primary"
                  />
                </div>
              </div>
              <div>
                <p class="font-semibold text-sm leading-snug">
                  12-week programme included
                </p>
                <p class="text-xs text-base-content/50 mt-0.5">
                  Your membership includes a personalised programme.
                </p>
              </div>
            </div>
            <a href="/programmes/12-week/onboarding" class="btn btn-primary btn-sm w-full">
              Complete programme form
            </a>
          </div>
        </div>
      )
    }

  </div>
</DashboardLayout>

<script>
  const DISMISS_KEY = "breakthru_12week_toast_dismissed";
  const toast = document.getElementById("programme-toast");
  const dismissBtn = document.getElementById("dismiss-toast");

  if (toast) {
    // Hide immediately if previously dismissed
    if (localStorage.getItem(DISMISS_KEY) === "1") {
      toast.classList.add("hidden");
    }

    dismissBtn?.addEventListener("click", () => {
      localStorage.setItem(DISMISS_KEY, "1");
      toast.classList.add("hidden");
    });
  }
</script>
