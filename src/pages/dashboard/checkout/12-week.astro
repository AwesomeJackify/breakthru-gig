---
import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import { getUserEntitlements } from "../../../lib/access";
import config from "../../../../breakthru.config.json";

const { programmeCheckout, services } = config;
const programme = services.tiers.find((tier) => tier.product === "12week_programme");
const entitlements = await getUserEntitlements(Astro.locals.user!.id, Astro.locals.supabase);
if (entitlements.hasProgramme) return Astro.redirect("/dashboard?notice=programme-owned");
---

<DashboardLayout title="Secure 12-week checkout — Breakthru">
  <main class="min-h-screen px-6 py-10">
    <div class="max-w-xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary mb-3">{programmeCheckout.eyebrow}</p>
      <h1 class="text-3xl font-bold">{programmeCheckout.paymentHeadline}</h1>
      <p class="mt-3 text-base-content/60">{programmeCheckout.paymentNote}</p>
      <div class="card bg-base-200 border border-base-300 mt-8">
        <div class="card-body gap-5">
          <div>
            <h2 class="font-semibold text-xl">{programme?.title}</h2>
            <p class="text-sm text-base-content/60 mt-1">{programme?.description}</p>
          </div>
          <div><span class="text-4xl font-black">{programme?.price}</span><span class="text-sm text-base-content/50 ml-2">{programme?.billing}</span></div>
          <form method="POST" action="/api/checkout/one-time">
            <input type="hidden" name="product" value="12week_programme" />
            <button class="btn btn-primary btn-lg w-full" type="submit">{programmeCheckout.paymentButton}</button>
          </form>
        </div>
      </div>
    </div>
  </main>
</DashboardLayout>
