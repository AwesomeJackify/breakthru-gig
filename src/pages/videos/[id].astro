---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getUserEntitlements, canWatchVideo } from "../../lib/access";
import {
  getPlaybackToken,
  getThumbnailToken,
  getStoryboardToken,
} from "../../lib/mux";
import config from "../../../breakthru.config.json";

const { id } = Astro.params;
const user = Astro.locals.user!;
const supabase = Astro.locals.supabase;

const { data: video } = await supabase
  .from("videos")
  .select(
    "id, title, description, category, access, mux_playback_id, status, thumbnail_time",
  )
  .eq("id", id)
  .eq("status", "ready")
  .single();

if (!video) return Astro.redirect("/videos");

const entitlements = await getUserEntitlements(user.id, supabase);
const allowed = canWatchVideo(
  entitlements,
  video.access as "subscription" | "programme_12week",
);
if (!allowed) return Astro.redirect("/subscribe");

// Up-next videos from same category
const { data: relatedVideos } = await supabase
  .from("videos")
  .select(
    "id, title, description, mux_playback_id, duration, category, thumbnail_time",
  )
  .eq("status", "ready")
  .eq("category", video.category)
  .neq("id", video.id)
  .limit(3);

const upNext = relatedVideos ?? [];

type UpNext = {
  id: string;
  title: string;
  description: string;
  mux_playback_id: string;
  duration: number;
  category: string;
  thumbnail_time: number;
};

// Generate all tokens in parallel (local JWT signing — no network calls).
// posterToken bakes in the chosen cover time so the player's poster shows the
// selected frame; thumbnailToken stays generic for the player's own use.
const [playbackToken, posterToken, thumbnailToken, storyboardToken] =
  await Promise.all([
    getPlaybackToken(video.mux_playback_id),
    getThumbnailToken(video.mux_playback_id, video.thumbnail_time ?? 10),
    getThumbnailToken(video.mux_playback_id),
    getStoryboardToken(video.mux_playback_id),
  ]);

const posterUrl = `https://image.mux.com/${video.mux_playback_id}/thumbnail.jpg?token=${posterToken}`;

// Up-next covers — each token bakes in that video's own cover time.
const upNextThumbMap: Record<string, string> = {};
await Promise.all(
  (upNext as UpNext[])
    .filter((v) => v.mux_playback_id)
    .map(async (v) => {
      upNextThumbMap[v.mux_playback_id] = await getThumbnailToken(
        v.mux_playback_id,
        v.thumbnail_time ?? 10,
      );
    }),
);

const categoryLabel =
  config.videoCategories.find((c) => c.value === video.category)?.label ??
  video.category.charAt(0).toUpperCase() + video.category.slice(1);
---

<DashboardLayout title={`${video.title} — Breakthru`}>
  <main class="min-h-screen px-6 py-10">
    <div class="max-w-4xl mx-auto">
      {/* Breadcrumbs */}
      <div class="breadcrumbs text-sm mb-6">
        <ul>
          <li><a href="/videos">Library</a></li>
          <li>
            <a href={`/videos?category=${video.category}`}>{categoryLabel}</a>
          </li>
          <li class="max-w-xs truncate">{video.title}</li>
        </ul>
      </div>

      {/* Player — content is portrait (9:16); size the frame to the video
          instead of a 16:9 box so it isn't pillarboxed in black */}
      <div class="rounded-xl overflow-hidden mb-6 bg-black mx-auto aspect-[9/16] h-[70vh] max-h-[720px] max-w-full">
        <mux-player
          playback-id={video.mux_playback_id}
          playback-token={playbackToken}
          thumbnail-token={thumbnailToken}
          storyboard-token={storyboardToken}
          poster={posterUrl}
          metadata-video-title={video.title}
          metadata-viewer-user-id={user.id}
          style="width:100%;height:100%;"></mux-player>
      </div>

      {/* Video info */}
      <div class="mb-10">
        <span class="badge badge-outline text-xs mb-2">{categoryLabel}</span>
        <h1 class="text-2xl font-bold">{video.title}</h1>
        {
          video.description && (
            <p class="text-base-content/60 mt-3">{video.description}</p>
          )
        }
      </div>

      {/* Up next */}
      {
        upNext.length > 0 && (
          <section>
            <h2 class="text-lg font-semibold mb-4">Up next</h2>
            <div class="flex flex-col gap-3">
              {upNext.map(
                (v: {
                  id: string;
                  title: string;
                  description: string;
                  mux_playback_id: string;
                  duration: number;
                  category: string;
                  thumbnail_time: number;
                }) => (
                  <a
                    href={`/videos/${v.id}`}
                    class="card card-side bg-base-200 hover:bg-base-300 transition-colors overflow-hidden group"
                  >
                    <figure class="w-24 shrink-0 aspect-[9/16] relative overflow-hidden">
                      {v.mux_playback_id &&
                      upNextThumbMap[v.mux_playback_id] ? (
                        <img
                          src={`https://image.mux.com/${v.mux_playback_id}/thumbnail.jpg?token=${upNextThumbMap[v.mux_playback_id]}`}
                          alt={v.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                        />
                      ) : (
                        <div class="skeleton w-full h-full min-h-24" />
                      )}
                      {/* w-fit/h-fit: DaisyUI stretches figure children to
                          100% — without them this badge becomes a black
                          overlay across the whole thumbnail */}
                      {v.duration > 0 && (
                        <span class="absolute bottom-1 right-1 w-fit h-fit bg-black/80 text-white text-xs px-1 py-px rounded">
                          {Math.floor(v.duration / 60)}:
                          {String(v.duration % 60).padStart(2, "0")}
                        </span>
                      )}
                    </figure>
                    <div class="card-body p-4 justify-center">
                      <h3 class="font-semibold leading-snug">{v.title}</h3>
                      {v.description && (
                        <p class="text-sm text-base-content/60 line-clamp-2">
                          {v.description}
                        </p>
                      )}
                    </div>
                  </a>
                ),
              )}
            </div>
          </section>
        )
      }
    </div>
  </main>
</DashboardLayout>

<script type="module" src="https://cdn.jsdelivr.net/npm/@mux/mux-player"
></script>
