---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import { getUserEntitlements } from "../../lib/access";
import { getThumbnailToken } from "../../lib/mux";
import config from "../../../breakthru.config.json";

// Teaser photos for coming-soon categories — folder name matches the
// category value (src/assets/images/coming-soon/<value>/*.jpeg).
const comingSoonGlob = import.meta.glob<{ default: ImageMetadata }>(
  "../../assets/images/coming-soon/*/*.jpeg",
  { eager: true },
);
function comingSoonImages(catValue: string): ImageMetadata[] {
  return Object.entries(comingSoonGlob)
    .filter(([path]) => path.includes(`/coming-soon/${catValue}/`))
    .sort(([a], [b]) => a.localeCompare(b))
    .map(([, mod]) => mod.default);
}

const user = Astro.locals.user!;
const supabase = Astro.locals.supabase;

const entitlements = await getUserEntitlements(user.id, supabase);

if (!entitlements.hasSubscription && !entitlements.hasProgramme) {
  return Astro.redirect("/subscribe");
}

const { data: videos } = await supabase
  .from("videos")
  .select(
    "id, title, description, category, access, mux_playback_id, duration, status, thumbnail_time",
  )
  .eq("status", "ready")
  .order("created_at", { ascending: false });

const allVideos = videos ?? [];

const videoCategories = config.videoCategories;

type Video = {
  id: string;
  title: string;
  description: string;
  category: string;
  mux_playback_id: string;
  duration: number;
  thumbnail_time: number;
};

// Generate thumbnail tokens in parallel (local JWT signing — no network calls).
// The cover frame time is baked into each token (Mux ignores ?time= on signed
// URLs), so each video gets a token keyed to its own thumbnail_time.
const thumbTokens: Record<string, string> = {};
await Promise.all(
  (allVideos as Video[])
    .filter((v) => v.mux_playback_id)
    .map(async (v) => {
      thumbTokens[v.mux_playback_id] = await getThumbnailToken(
        v.mux_playback_id,
        v.thumbnail_time ?? 10,
      );
    }),
);

const videosByCategory = Object.fromEntries(
  videoCategories.map((cat) => [
    cat.value,
    allVideos.filter((v: Video) => v.category === cat.value),
  ]),
);

// Up to 5 videos for the hero carousel — only ones with a thumbnail token
const heroVideos = (allVideos as Video[])
  .filter((v) => v.mux_playback_id && thumbTokens[v.mux_playback_id])
  .slice(0, 5);

function formatDuration(s: number) {
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
}
---

<DashboardLayout title="Videos — Breakthru">
  {
    allVideos.length === 0 ? (
      <div class="flex flex-col items-center justify-center min-h-screen text-base-content/40">
        <Icon name="lucide:video" class="w-16 h-16 mb-4 opacity-20" />
        <p class="text-lg font-medium">No videos yet</p>
        <p class="text-sm mt-1">Check back soon for new content.</p>
      </div>
    ) : (
      <div class="pb-16">
        {/* Hero carousel */}
        {heroVideos.length > 0 && (
          <div
            id="hero"
            class="relative w-full overflow-hidden"
            style="height: clamp(320px, 55vw, 560px);"
          >
            {/* Slides — all stacked, opacity controls which is visible */}
            {heroVideos.map((video, i) => (
              <div
                class="hero-slide absolute inset-0 transition-opacity duration-700"
                class:list={[
                  i === 0 ? "opacity-100" : "opacity-0 pointer-events-none",
                ]}
                data-index={i}
              >
                <img
                  src={`https://image.mux.com/${video.mux_playback_id}/thumbnail.jpg?token=${thumbTokens[video.mux_playback_id]}`}
                  alt={video.title}
                  class="absolute inset-0 w-full h-full object-cover"
                />
                <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/40 to-transparent" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/20" />

                <div class="absolute inset-0 flex flex-col justify-end px-8 pb-14 md:px-14 md:pb-16 max-w-2xl">
                  <span class="badge badge-primary badge-sm mb-3 capitalize w-fit">
                    {video.category}
                  </span>
                  <h2 class="text-3xl md:text-5xl font-bold text-white leading-tight mb-3">
                    {video.title}
                  </h2>
                  {video.description && (
                    <p class="text-white/65 text-sm md:text-base line-clamp-2 mb-5">
                      {video.description}
                    </p>
                  )}
                  <div class="flex items-center gap-3">
                    <a
                      href={`/videos/${video.id}`}
                      class="btn btn-primary gap-2 rounded-full px-6"
                    >
                      <Icon name="lucide:play" class="w-4 h-4 fill-current" />
                      Play now
                    </a>
                    {video.duration > 0 && (
                      <span class="text-white/50 text-sm">
                        {formatDuration(video.duration)}
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))}

            {/* Progress dots — fill left to right over 8s */}
            {heroVideos.length > 1 && (
              <div class="absolute bottom-5 left-8 md:left-14 flex items-center gap-2">
                {heroVideos.map((_, i) => (
                  <button
                    class="hero-dot relative w-8 h-1.5 rounded-full overflow-hidden bg-white/30 focus:outline-none"
                    data-index={i}
                    aria-label={`Go to slide ${i + 1}`}
                  >
                    <span
                      class:list={[
                        "dot-fill block h-full w-full bg-white rounded-full origin-left",
                        i === 0 ? "animating" : "",
                      ]}
                    />
                  </button>
                ))}
              </div>
            )}

            {/* Admin upload button */}
            {user.is_admin && (
              <div class="absolute top-5 right-6">
                <a
                  href="/admin/upload"
                  class="btn btn-sm btn-primary gap-2 opacity-90"
                >
                  <Icon name="lucide:plus" class="w-4 h-4" />
                  Upload
                </a>
              </div>
            )}
          </div>
        )}

        {/* Category rows */}
        <div class="mt-8 space-y-10">
          {videoCategories.map((cat) => {
            if (cat.comingSoon) {
              const teasers = comingSoonImages(cat.value);
              return (
                <section>
                  <h2 class="text-lg font-semibold px-8 md:px-14 mb-3 text-base-content/90 flex flex-wrap items-center gap-2 min-w-0">
                    <span class="min-w-0">{cat.label}</span>
                    <span class="badge badge-outline badge-sm shrink-0 whitespace-nowrap">
                      Coming soon
                    </span>
                  </h2>
                  <div class="overflow-x-auto scrollbar-hide">
                    <div class="flex gap-3 px-8 md:px-14 pb-2 w-max">
                      {(teasers.length > 0 ? teasers : [null, null, null, null]).map(
                        (img) => (
                          <div
                            class="shrink-0 rounded-lg overflow-hidden bg-base-300 relative"
                            style="width: clamp(160px, 22vw, 260px)"
                          >
                            <div class="aspect-video w-full relative overflow-hidden">
                              {img ? (
                                <Image
                                  src={img}
                                  alt={`${cat.label} — coming soon`}
                                  width={520}
                                  class="absolute inset-0 w-full h-full object-cover"
                                  loading="lazy"
                                />
                              ) : (
                                <div class="skeleton w-full h-full absolute inset-0 opacity-40" />
                              )}
                              <div class="absolute inset-0 bg-black/45 flex items-center justify-center">
                                <Icon
                                  name="lucide:lock"
                                  class:list={[
                                    "w-6 h-6",
                                    img ? "text-white/80" : "text-base-content/30",
                                  ]}
                                />
                              </div>
                            </div>
                          </div>
                        ),
                      )}
                    </div>
                  </div>
                </section>
              );
            }
            const row = videosByCategory[cat.value];
            if (!row || row.length === 0) return null;
            return (
              <section>
                <h2 class="text-lg font-semibold px-8 md:px-14 mb-3 text-base-content/90">
                  {cat.label}
                </h2>
                <div class="overflow-x-auto scrollbar-hide">
                  <div class="flex gap-3 px-8 md:px-14 pb-2 w-max">
                    {row.map((video: Video) => (
                      <a
                        href={`/videos/${video.id}`}
                        class="group relative block rounded-lg overflow-hidden shrink-0 bg-base-300 focus-visible:ring-2 focus-visible:ring-primary outline-none"
                        style="width: clamp(160px, 22vw, 260px)"
                      >
                        <div class="aspect-video w-full overflow-hidden relative">
                          {video.mux_playback_id &&
                          thumbTokens[video.mux_playback_id] ? (
                            <img
                              src={`https://image.mux.com/${video.mux_playback_id}/thumbnail.jpg?token=${thumbTokens[video.mux_playback_id]}`}
                              alt={video.title}
                              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                              loading="lazy"
                              onerror="this.style.display='none';this.nextElementSibling.style.display='block'"
                            />
                          ) : null}
                          <div
                            class="skeleton w-full h-full absolute inset-0"
                            style={
                              video.mux_playback_id &&
                              thumbTokens[video.mux_playback_id]
                                ? "display:none"
                                : ""
                            }
                          />
                        </div>

                        {video.duration > 0 && (
                          <span class="absolute top-2 right-2 bg-black/70 text-white text-xs px-1.5 py-0.5 rounded font-mono">
                            {formatDuration(video.duration)}
                          </span>
                        )}

                        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-250 flex flex-col justify-end p-3">
                          <div class="flex items-center gap-2 mb-1.5">
                            <div class="w-7 h-7 rounded-full bg-primary flex items-center justify-center shrink-0">
                              <Icon
                                name="lucide:play"
                                class="w-3.5 h-3.5 text-primary-content translate-x-px"
                              />
                            </div>
                          </div>
                          <p class="text-white text-xs font-semibold leading-snug line-clamp-2">
                            {video.title}
                          </p>
                          {video.description && (
                            <p class="text-white/55 text-xs mt-0.5 line-clamp-1">
                              {video.description}
                            </p>
                          )}
                        </div>
                      </a>
                    ))}
                  </div>
                </div>
              </section>
            );
          })}
        </div>
      </div>
    )
  }
</DashboardLayout>

<style>
  .scrollbar-hide {
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  @keyframes dot-progress {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
  .dot-fill {
    transform: scaleX(0);
  }
  .dot-fill.animating {
    animation: dot-progress 8s linear forwards;
  }
</style>

<script>
  const DURATION = 8000;

  const hero = document.getElementById("hero");
  if (hero) {
    const slides = hero.querySelectorAll<HTMLElement>(".hero-slide");
    const dots = hero.querySelectorAll<HTMLButtonElement>(".hero-dot");

    if (slides.length > 1) {
      let current = 0;
      let timer: ReturnType<typeof setInterval>;

      function getFill(i: number): HTMLElement | null {
        return dots[i]?.querySelector<HTMLElement>(".dot-fill") ?? null;
      }

      function startFill(i: number) {
        const fill = getFill(i);
        if (!fill) return;
        fill.classList.remove("animating");
        void fill.offsetWidth; // force reflow so animation restarts from 0
        fill.classList.add("animating");
      }

      function stopFill(i: number) {
        getFill(i)?.classList.remove("animating");
      }

      function goTo(index: number) {
        stopFill(current);
        slides[current].classList.remove("opacity-100");
        slides[current].classList.add("opacity-0", "pointer-events-none");

        current = index;

        slides[current].classList.remove("opacity-0", "pointer-events-none");
        slides[current].classList.add("opacity-100");
        startFill(current);
      }

      function start() {
        startFill(current);
        timer = setInterval(
          () => goTo((current + 1) % slides.length),
          DURATION,
        );
      }

      function stop() {
        clearInterval(timer);
        stopFill(current);
      }

      start();

      hero.addEventListener("mouseenter", stop);
      hero.addEventListener("mouseleave", start);

      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          stop();
          goTo(i);
          start();
        });
      });
    }
  }
</script>
