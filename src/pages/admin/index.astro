---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Icon } from "astro-icon/components";
import config from "../../../breakthru.config.json";

const supabase = Astro.locals.supabase;

const { data: videos } = await supabase
  .from("videos")
  .select("id, title, description, category, access, status, created_at, duration, thumbnail_time")
  .order("created_at", { ascending: false });

const total = videos?.length ?? 0;
const readyCount = videos?.filter((v: { status: string }) => v.status === "ready").length ?? 0;
const processingCount = videos?.filter((v: { status: string }) => v.status === "processing" || v.status === "uploading").length ?? 0;
const countByCategory = Object.fromEntries(
  config.videoCategories.map((cat) => [
    cat.value,
    videos?.filter((v: { status: string; category: string }) => v.status === "ready" && v.category === cat.value).length ?? 0,
  ]),
);

const hasInProgress = processingCount > 0;

const statusBadge: Record<string, string> = {
  ready: "badge-success",
  processing: "badge-warning",
  uploading: "badge-info",
  errored: "badge-error",
};
---

<DashboardLayout title="Admin — Breakthru">
  <main class="min-h-screen px-6 py-10">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <h1 class="text-3xl font-bold">Video library</h1>
        <a href="/admin/upload" class="btn btn-primary gap-2">
          <Icon name="lucide:plus" class="w-4 h-4" />
          Upload video
        </a>
      </div>

      {/* Stats */}
      <div class="stats stats-horizontal shadow w-full mb-8 border border-base-300">
        <div class="stat">
          <div class="stat-title">Total videos</div>
          <div class="stat-value text-2xl">{total}</div>
        </div>
        <div class="stat">
          <div class="stat-title">Ready</div>
          <div class="stat-value text-2xl text-success">{readyCount}</div>
        </div>
        <div class="stat">
          <div class="stat-title">Processing</div>
          <div class="stat-value text-2xl">{processingCount}</div>
          {processingCount > 0 && (
            <div class="stat-desc flex items-center gap-1">
              <span class="loading loading-spinner loading-xs"></span>
              Auto-refreshing
            </div>
          )}
        </div>
        <div class="stat">
          <div class="stat-title">By category</div>
          <div class="stat-desc mt-1 flex flex-col gap-1">
            {config.videoCategories.map((cat) => (
              <span>
                <span class="badge badge-outline badge-xs">{cat.label}</span>{" "}
                {countByCategory[cat.value] ?? 0}
              </span>
            ))}
          </div>
        </div>
      </div>

      {!videos || videos.length === 0 ? (
        <div class="text-center py-24 border border-dashed border-base-300 rounded-xl">
          <p class="text-base-content/40 mb-4">No videos yet.</p>
          <a href="/admin/upload" class="btn btn-primary">Upload your first video</a>
        </div>
      ) : (
        <div class="overflow-x-auto rounded-xl border border-base-300">
          <table class="table">
            <thead>
              <tr>
                <th>Title</th>
                <th>Category</th>
                <th>Access</th>
                <th>Status</th>
                <th>Uploaded</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {videos.map((v: { id: string; title: string; description: string; category: string; access: string; status: string; created_at: string; duration: number | null; thumbnail_time: number | null }) => (
                <tr class="hover">
                  <td class="font-medium max-w-xs truncate">{v.title}</td>
                  <td><span class="badge badge-outline capitalize">{v.category}</span></td>
                  <td>
                    <span class="badge badge-ghost capitalize text-xs">
                      {v.access === "subscription" ? "All members" : "Programme"}
                    </span>
                  </td>
                  <td>
                    <span class:list={["badge capitalize text-xs", statusBadge[v.status] ?? "badge-ghost"]}>
                      {v.status}
                    </span>
                  </td>
                  <td class="text-base-content/50 text-sm">
                    {new Date(v.created_at).toLocaleDateString("en-NZ", { day: "numeric", month: "short", year: "numeric" })}
                  </td>
                  <td>
                    <div class="flex gap-2">
                      {v.status === "ready" && (
                        <a href={`/videos/${v.id}`} class="btn btn-ghost btn-xs">View</a>
                      )}
                      <button
                        class="btn btn-ghost btn-xs"
                        data-edit-id={v.id}
                        data-edit-title={v.title}
                        data-edit-description={v.description ?? ""}
                        data-edit-category={v.category}
                        data-edit-access={v.access}
                        data-edit-status={v.status}
                        data-edit-duration={v.duration ?? 0}
                        data-edit-thumbnail-time={v.thumbnail_time ?? 10}
                      >
                        Edit
                      </button>
                      <button
                        class="btn btn-ghost btn-xs text-error"
                        data-delete-id={v.id}
                        data-delete-title={v.title}
                      >
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </main>

  {/* Delete modal */}
  <dialog id="delete-modal" class="modal">
    <div class="modal-box">
      <h3 class="font-bold text-lg">Delete video</h3>
      <p class="py-4">
        Are you sure you want to delete "<span id="delete-title"></span>"? This cannot be undone.
      </p>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost">Cancel</button>
        </form>
        <button id="confirm-delete" class="btn btn-error">Delete</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  {/* Edit modal */}
  <dialog id="edit-modal" class="modal">
    <div class="modal-box">
      <h3 class="font-bold text-lg mb-4">Edit video</h3>
      <div class="flex flex-col gap-4">
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Title <span class="text-error">*</span></legend>
          <input id="edit-title" type="text" class="input w-full" />
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Description</legend>
          <textarea id="edit-description" class="textarea w-full" rows="3"></textarea>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Category</legend>
          <select id="edit-category" class="select w-full">
            {config.videoCategories.map((cat) => (
              <option value={cat.value}>{cat.label}</option>
            ))}
          </select>
        </fieldset>
        <fieldset class="fieldset">
          <legend class="fieldset-legend">Access</legend>
          <select id="edit-access" class="select w-full">
            <option value="subscription">All members (subscription)</option>
            <option value="programme_12week">12-week programme only</option>
          </select>
        </fieldset>

        {/* Cover frame picker — only usable once the video is ready */}
        <fieldset id="edit-cover" class="fieldset hidden">
          <legend class="fieldset-legend">
            Cover frame
            <span id="edit-cover-time" class="text-xs text-base-content/50 font-mono ml-1">0:10</span>
          </legend>
          <div class="aspect-video bg-base-300 rounded-lg overflow-hidden mb-2">
            <img id="edit-cover-img" src="" alt="Video cover" class="w-full h-full object-cover" />
          </div>
          <input id="edit-cover-slider" type="range" min="0" max="10" step="0.5" value="10" class="range range-primary range-sm w-full" />
          <p class="text-xs text-base-content/40 mt-1">Drag to choose the frame shown as the cover.</p>
        </fieldset>

        <div id="edit-error" class="alert alert-error hidden text-sm"></div>
      </div>
      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-ghost">Cancel</button>
        </form>
        <button id="confirm-edit" class="btn btn-primary">Save changes</button>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
</DashboardLayout>

<script define:vars={{ hasInProgress }}>
  // Delete
  let pendingDeleteId = null;
  const deleteModal = document.getElementById("delete-modal");
  const deleteTitleEl = document.getElementById("delete-title");
  const confirmDeleteBtn = document.getElementById("confirm-delete");

  document.querySelectorAll("[data-delete-id]").forEach((btn) => {
    btn.addEventListener("click", () => {
      pendingDeleteId = btn.dataset.deleteId;
      deleteTitleEl.textContent = btn.dataset.deleteTitle ?? "";
      deleteModal.showModal();
    });
  });

  confirmDeleteBtn.addEventListener("click", async () => {
    if (!pendingDeleteId) return;
    confirmDeleteBtn.textContent = "Deleting...";
    confirmDeleteBtn.setAttribute("disabled", "true");
    const res = await fetch(`/api/admin/videos/${pendingDeleteId}`, { method: "DELETE" });
    if (res.ok) {
      window.location.reload();
    } else {
      alert("Failed to delete video. Please try again.");
      confirmDeleteBtn.textContent = "Delete";
      confirmDeleteBtn.removeAttribute("disabled");
    }
  });

  // Edit
  let pendingEditId = null;
  const editModal = document.getElementById("edit-modal");
  const editTitleEl = document.getElementById("edit-title");
  const editDescEl = document.getElementById("edit-description");
  const editCatEl = document.getElementById("edit-category");
  const editAccessEl = document.getElementById("edit-access");
  const editErrorEl = document.getElementById("edit-error");
  const confirmEditBtn = document.getElementById("confirm-edit");
  const editCover = document.getElementById("edit-cover");
  const editCoverImg = document.getElementById("edit-cover-img");
  const editCoverSlider = document.getElementById("edit-cover-slider");
  const editCoverTime = document.getElementById("edit-cover-time");
  let coverPreviewTimer = null;

  const clock = (s) => {
    const t = Math.round(s);
    return Math.floor(t / 60) + ":" + String(t % 60).padStart(2, "0");
  };

  // Live scrub the cover preview while dragging (debounced).
  editCoverSlider.addEventListener("input", () => {
    const t = Number(editCoverSlider.value);
    editCoverTime.textContent = clock(t);
    if (coverPreviewTimer) clearTimeout(coverPreviewTimer);
    coverPreviewTimer = setTimeout(() => {
      if (pendingEditId) {
        editCoverImg.src = `/api/admin/videos/${pendingEditId}/thumbnail?time=${t}`;
      }
    }, 150);
  });

  document.querySelectorAll("[data-edit-id]").forEach((btn) => {
    btn.addEventListener("click", () => {
      pendingEditId = btn.dataset.editId;
      editTitleEl.value = btn.dataset.editTitle ?? "";
      editDescEl.value = btn.dataset.editDescription ?? "";
      editCatEl.value = btn.dataset.editCategory ?? "workouts";
      editAccessEl.value = btn.dataset.editAccess ?? "subscription";
      editErrorEl.classList.add("hidden");
      confirmEditBtn.textContent = "Save changes";
      confirmEditBtn.removeAttribute("disabled");

      // Cover picker is only usable for ready videos (they have a playback id).
      if (btn.dataset.editStatus === "ready") {
        const duration = Number(btn.dataset.editDuration || "0");
        const thumbTime = Number(btn.dataset.editThumbnailTime || "10");
        const max = duration > 0 ? duration : 10;
        const initial = Math.min(thumbTime, max);
        editCoverSlider.max = String(max);
        editCoverSlider.step = max > 60 ? "1" : "0.5";
        editCoverSlider.value = String(initial);
        editCoverTime.textContent = clock(initial);
        editCoverImg.src = `/api/admin/videos/${pendingEditId}/thumbnail?time=${initial}`;
        editCover.classList.remove("hidden");
      } else {
        editCover.classList.add("hidden");
      }

      editModal.showModal();
    });
  });

  confirmEditBtn.addEventListener("click", async () => {
    if (!pendingEditId) return;
    const title = editTitleEl.value.trim();
    if (!title) {
      editErrorEl.textContent = "Title is required.";
      editErrorEl.classList.remove("hidden");
      return;
    }
    confirmEditBtn.textContent = "Saving...";
    confirmEditBtn.setAttribute("disabled", "true");
    const res = await fetch(`/api/admin/videos/${pendingEditId}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        title,
        description: editDescEl.value,
        category: editCatEl.value,
        access: editAccessEl.value,
        ...(editCover.classList.contains("hidden")
          ? {}
          : { thumbnail_time: Number(editCoverSlider.value) }),
      }),
    });
    if (res.ok) {
      window.location.reload();
    } else {
      editErrorEl.textContent = "Failed to save. Please try again.";
      editErrorEl.classList.remove("hidden");
      confirmEditBtn.textContent = "Save changes";
      confirmEditBtn.removeAttribute("disabled");
    }
  });

  // Auto-refresh when videos are still processing
  if (hasInProgress) {
    setTimeout(() => window.location.reload(), 10000);
  }
</script>
