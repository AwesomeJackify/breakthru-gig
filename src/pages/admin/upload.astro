---
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { Icon } from "astro-icon/components";
import config from "../../../breakthru.config.json";
---

<DashboardLayout title="Upload video — Breakthru Admin">
  <main class="min-h-screen px-6 py-10">
    <div class="max-w-4xl mx-auto">
      <div class="mb-8">
        <div class="breadcrumbs text-sm mb-4">
          <ul>
            <li><a href="/admin">Library</a></li>
            <li>Upload</li>
          </ul>
        </div>
        <h1 class="text-3xl font-bold">Upload video</h1>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {/* Upload zone */}
        <div>
          <div
            id="drop-zone"
            class="relative border-2 border-dashed border-base-300 rounded-xl flex flex-col items-center justify-center gap-4 p-12 text-center transition-colors hover:border-primary hover:bg-primary/5"
          >
            {/* Transparent full-size file input — this IS the click target */}
            <input
              id="file-input"
              type="file"
              accept="video/*"
              class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10"
            />
            {/* Visual content sits below the input, pointer-events-none so clicks pass through */}
            <div id="dz-idle" class="pointer-events-none">
              <Icon name="lucide:cloud-upload" class="w-12 h-12 text-base-content/30 mx-auto mb-3" />
              <p class="font-semibold text-base-content/60">
                Drag and drop your video here
              </p>
              <p class="text-sm text-base-content/40 mt-1">or click to browse</p>
              <p class="text-xs text-base-content/30 mt-3">
                MP4, MOV, MKV — up to 10 GB
              </p>
            </div>
            <div id="dz-file" class="hidden w-full pointer-events-none">
              <Icon name="lucide:video" class="w-10 h-10 text-primary mx-auto mb-2" />
              <p id="file-name" class="font-medium text-sm truncate max-w-full px-2"></p>
              <p id="file-size" class="text-xs text-base-content/40 mt-1"></p>
            </div>
          </div>

          {/* Progress area */}
          <div id="progress-area" class="hidden mt-6">
            <div class="flex items-center justify-between text-sm mb-2">
              <span id="progress-label" class="font-medium">Uploading...</span>
              <span id="progress-pct" class="text-base-content/50">0%</span>
            </div>
            <progress
              id="progress-bar"
              class="progress progress-primary w-full"
              value="0"
              max="100"
            ></progress>
          </div>

          {/* Processing state */}
          <div id="processing-area" class="hidden mt-6">
            <div class="flex items-center gap-3">
              <span class="loading loading-spinner loading-sm text-primary"></span>
              <span class="text-sm font-medium">Processing video...</span>
            </div>
          </div>

          {/* Ready state */}
          <div id="ready-area" class="hidden mt-6">
            <div
              id="thumbnail-preview"
              class="aspect-video bg-base-300 rounded-xl overflow-hidden mb-3"
            >
              <img
                id="thumbnail-img"
                src=""
                alt="Video cover"
                class="w-full h-full object-cover"
              />
            </div>

            {/* Cover frame picker — drag to choose the cover, like Instagram */}
            <div id="cover-picker" class="mb-4">
              <div class="flex items-center justify-between mb-1">
                <span class="text-sm font-medium">Cover frame</span>
                <span
                  id="cover-time-label"
                  class="text-xs text-base-content/50 font-mono">0:10</span
                >
              </div>
              <input
                id="cover-slider"
                type="range"
                min="0"
                max="10"
                step="0.5"
                value="10"
                class="range range-primary range-sm w-full"
              />
              <div class="flex items-center justify-between mt-1">
                <p class="text-xs text-base-content/40">
                  Drag to choose the frame shown as the cover.
                </p>
                <span
                  id="cover-saved"
                  class="badge badge-success badge-sm hidden">Cover saved</span
                >
              </div>
            </div>

            <a id="view-link" href="#" class="btn btn-primary w-full">View video</a>
          </div>

          {/* Error state */}
          <div id="error-area" class="hidden mt-6 alert alert-error">
            <span id="error-msg">Upload failed.</span>
            <button id="retry-btn" class="btn btn-sm btn-ghost ml-auto">Retry</button>
          </div>
        </div>

        {/* Metadata form */}
        <div id="meta-form" class="hidden">
          <div class="card bg-base-200">
            <div class="card-body gap-4">
              <div class="flex items-center justify-between">
                <h2 class="card-title text-lg">Video details</h2>
                <span id="saved-badge" class="badge badge-success hidden">Saved</span>
              </div>

              <fieldset class="fieldset">
                <legend class="fieldset-legend">
                  Title <span class="text-error">*</span>
                </legend>
                <input
                  id="meta-title"
                  type="text"
                  class="input w-full"
                  placeholder="e.g. Full body workout — week 1"
                />
              </fieldset>

              <fieldset class="fieldset">
                <legend class="fieldset-legend">Description</legend>
                <textarea
                  id="meta-description"
                  class="textarea w-full"
                  rows="3"
                  placeholder="Optional description..."></textarea>
              </fieldset>

              <fieldset class="fieldset">
                <legend class="fieldset-legend">Category</legend>
                <select id="meta-category" class="select w-full">
                  {config.videoCategories.map((cat) => (
                    <option value={cat.value} disabled={cat.comingSoon}>
                      {cat.label}
                      {cat.comingSoon ? " (coming soon)" : ""}
                    </option>
                  ))}
                </select>
              </fieldset>

              <fieldset class="fieldset">
                <legend class="fieldset-legend">Access</legend>
                <select id="meta-access" class="select w-full">
                  <option value="subscription">All members (subscription)</option>
                  <option value="programme_12week">12-week programme only</option>
                </select>
              </fieldset>

              <p id="save-hint" class="text-xs text-base-content/40">
                Details save automatically when upload completes.
              </p>

              <button
                id="update-btn"
                class="btn btn-outline w-full hidden"
              >
                Update details
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</DashboardLayout>

<script>
  import { createUpload as UpChunkCreate } from "@mux/upchunk";

  const dropZone = document.getElementById("drop-zone")!;
  const fileInput = document.getElementById("file-input") as HTMLInputElement;
  const dzIdle = document.getElementById("dz-idle")!;
  const dzFile = document.getElementById("dz-file")!;
  const fileNameEl = document.getElementById("file-name")!;
  const fileSizeEl = document.getElementById("file-size")!;
  const progressArea = document.getElementById("progress-area")!;
  const progressLabel = document.getElementById("progress-label")!;
  const progressPct = document.getElementById("progress-pct")!;
  const progressBar = document.getElementById("progress-bar") as HTMLProgressElement;
  const processingArea = document.getElementById("processing-area")!;
  const readyArea = document.getElementById("ready-area")!;
  const thumbnailImg = document.getElementById("thumbnail-img") as HTMLImageElement;
  const coverSlider = document.getElementById("cover-slider") as HTMLInputElement;
  const coverTimeLabel = document.getElementById("cover-time-label")!;
  const coverSaved = document.getElementById("cover-saved")!;
  const viewLink = document.getElementById("view-link") as HTMLAnchorElement;
  const errorArea = document.getElementById("error-area")!;
  const errorMsg = document.getElementById("error-msg")!;
  const retryBtn = document.getElementById("retry-btn")!;
  const metaForm = document.getElementById("meta-form")!;
  const savedBadge = document.getElementById("saved-badge")!;
  const saveHint = document.getElementById("save-hint")!;
  const updateBtn = document.getElementById("update-btn") as HTMLButtonElement;
  const metaTitle = document.getElementById("meta-title") as HTMLInputElement;
  const metaDescription = document.getElementById("meta-description") as HTMLTextAreaElement;
  const metaCategory = document.getElementById("meta-category") as HTMLSelectElement;
  const metaAccess = document.getElementById("meta-access") as HTMLSelectElement;

  let currentUploadId: string | null = null;
  let currentVideoId: string | null = null;
  let pollingTimer: ReturnType<typeof setInterval> | null = null;
  let coverPreviewTimer: ReturnType<typeof setTimeout> | null = null;

  function formatBytes(bytes: number) {
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    if (bytes < 1024 * 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
    return `${(bytes / (1024 * 1024 * 1024)).toFixed(2)} GB`;
  }

  function formatClock(s: number) {
    const total = Math.round(s);
    return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, "0")}`;
  }

  function coverUrl(time: number) {
    // Server signs a token for this exact frame time and redirects to Mux.
    return `/api/admin/videos/${currentVideoId}/thumbnail?time=${time}`;
  }

  // Wire up the cover-frame picker once the video is ready.
  function initCoverPicker(duration: number | null) {
    const max = duration && duration > 0 ? duration : 10;
    const initial = Math.min(10, max);
    coverSlider.max = String(max);
    coverSlider.step = max > 60 ? "1" : "0.5";
    coverSlider.value = String(initial);
    coverTimeLabel.textContent = formatClock(initial);
    thumbnailImg.src = coverUrl(initial);
  }

  async function saveCover(time: number) {
    if (!currentVideoId) return;
    coverSaved.classList.add("hidden");
    const res = await fetch(`/api/admin/videos/${currentVideoId}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ thumbnail_time: time }),
    });
    if (res.ok) {
      coverSaved.classList.remove("hidden");
      setTimeout(() => coverSaved.classList.add("hidden"), 2000);
    }
  }

  // Live scrub the preview while dragging (debounced so we don't hammer Mux)...
  coverSlider.addEventListener("input", () => {
    const t = Number(coverSlider.value);
    coverTimeLabel.textContent = formatClock(t);
    if (coverPreviewTimer) clearTimeout(coverPreviewTimer);
    coverPreviewTimer = setTimeout(() => {
      if (currentVideoId) thumbnailImg.src = coverUrl(t);
    }, 150);
  });
  // ...and persist the chosen frame on release.
  coverSlider.addEventListener("change", () => {
    saveCover(Number(coverSlider.value));
  });

  function showError(msg: string) {
    progressArea.classList.add("hidden");
    processingArea.classList.add("hidden");
    errorMsg.textContent = msg;
    errorArea.classList.remove("hidden");
  }

  async function saveMeta() {
    if (!currentVideoId) return false;
    const title = metaTitle.value.trim() || "Untitled video";
    const res = await fetch(`/api/admin/videos/${currentVideoId}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        title,
        description: metaDescription.value,
        category: metaCategory.value,
        access: metaAccess.value,
      }),
    });
    return res.ok;
  }

  function startPolling() {
    if (!currentUploadId) return;
    pollingTimer = setInterval(async () => {
      try {
        const res = await fetch(`/api/admin/upload/status?uploadId=${currentUploadId}`);
        const data = (await res.json()) as {
          status: string;
          videoId: string;
          playbackId: string;
          thumbToken: string;
          duration: number | null;
        };
        if (data.status === "ready") {
          clearInterval(pollingTimer!);
          processingArea.classList.add("hidden");
          currentVideoId = data.videoId;
          initCoverPicker(data.duration);
          viewLink.href = `/videos/${data.videoId}`;
          readyArea.classList.remove("hidden");
          // Auto-save all metadata
          const ok = await saveMeta();
          if (ok) {
            savedBadge.classList.remove("hidden");
            saveHint.classList.add("hidden");
            updateBtn.classList.remove("hidden");
          }
        } else if (data.status === "errored") {
          clearInterval(pollingTimer!);
          showError("Video processing failed. Please try again.");
        }
      } catch {
        // keep polling
      }
    }, 5000);
  }

  async function startUpload(file: File) {
    if (!file.type.startsWith("video/")) {
      showError("Please select a video file.");
      return;
    }

    // Disable the file input overlay so it doesn't intercept further interaction
    fileInput.classList.add("hidden");

    // Show file info and metadata form immediately
    dzIdle.classList.add("hidden");
    dzFile.classList.remove("hidden");
    fileNameEl.textContent = file.name;
    fileSizeEl.textContent = formatBytes(file.size);
    metaForm.classList.remove("hidden");

    // Pre-fill title from filename
    if (!metaTitle.value.trim()) {
      metaTitle.value = file.name.replace(/\.[^/.]+$/, "").replace(/[-_]/g, " ");
    }

    // Get upload URL — send current form values upfront
    let uploadUrl: string;
    try {
      const res = await fetch("/api/admin/upload/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: metaTitle.value.trim() || file.name.replace(/\.[^/.]+$/, ""),
          category: metaCategory.value,
          access: metaAccess.value,
        }),
      });
      if (!res.ok) throw new Error("Failed to get upload URL");
      const data = (await res.json()) as {
        uploadUrl: string;
        videoId: string;
        uploadId: string;
      };
      uploadUrl = data.uploadUrl;
      currentVideoId = data.videoId;
      currentUploadId = data.uploadId;
    } catch {
      showError("Failed to initialise upload. Please try again.");
      return;
    }

    progressArea.classList.remove("hidden");

    const upload = UpChunkCreate({
      endpoint: uploadUrl,
      file,
      chunkSize: 30720,
    });

    upload.on("progress", (e: { detail: number }) => {
      const pct = Math.round(e.detail);
      progressBar.value = pct;
      progressPct.textContent = `${pct}%`;
      progressLabel.textContent = pct < 100 ? `Uploading...` : "Upload complete";
    });

    upload.on("success", () => {
      progressArea.classList.add("hidden");
      processingArea.classList.remove("hidden");
      startPolling();
    });

    upload.on("error", (e: { detail: { message: string } }) => {
      showError(e.detail?.message ?? "Upload failed. Please try again.");
    });
  }

  // File input change handler
  fileInput.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) startUpload(file);
  });

  dropZone.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropZone.classList.add("border-primary", "bg-primary/5");
  });
  dropZone.addEventListener("dragleave", () => {
    dropZone.classList.remove("border-primary", "bg-primary/5");
  });
  dropZone.addEventListener("drop", (e) => {
    e.preventDefault();
    dropZone.classList.remove("border-primary", "bg-primary/5");
    const file = e.dataTransfer?.files[0];
    if (file) startUpload(file);
  });

  // Retry
  retryBtn.addEventListener("click", () => {
    errorArea.classList.add("hidden");
    dzIdle.classList.remove("hidden");
    dzFile.classList.add("hidden");
    metaForm.classList.add("hidden");
    progressArea.classList.add("hidden");
    savedBadge.classList.add("hidden");
    saveHint.classList.remove("hidden");
    updateBtn.classList.add("hidden");
    fileInput.value = "";
    fileInput.classList.remove("hidden");
    coverSaved.classList.add("hidden");
    currentUploadId = null;
    currentVideoId = null;
  });

  // Manual update after ready
  updateBtn.addEventListener("click", async () => {
    updateBtn.textContent = "Saving...";
    updateBtn.setAttribute("disabled", "true");
    const ok = await saveMeta();
    updateBtn.textContent = ok ? "Saved!" : "Update details";
    if (!ok) updateBtn.removeAttribute("disabled");
    else setTimeout(() => {
      updateBtn.textContent = "Update details";
      updateBtn.removeAttribute("disabled");
    }, 2000);
  });
</script>
