{
	"compatibility_date": "2026-03-12",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"name": "breakthru-gig",
	"assets": {
		"directory": "./dist",
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
